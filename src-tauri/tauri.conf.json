{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentDeck",
  "version": "0.2.0",
  "identifier": "dev.agentdeck.app",
  "build": {
    "beforeDevCommand": "pnpm sidecar && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm sidecar && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgentDeck",
        "width": 1240,
        "height": 800,
        "minWidth": 640,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5QzMzRkRGQzBDNzhFRUEKUldUcWpzZkEzei9EV2NBSmttbjBhd1M2L2tmOE9MTEtMWTgxSXlwaHVldTh3YTlQODY4a1dScTYK",
      "endpoints": [
        "https://github.com/AxelDoussoux/agentdeck/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/agentdeck"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
